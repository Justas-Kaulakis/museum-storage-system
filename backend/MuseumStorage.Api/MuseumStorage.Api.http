@MuseumStorage.Api_HostAddress = http://localhost:5054
@ZoneId = 1

GET {{MuseumStorage.Api_HostAddress}}/api/sensor-readings
Accept: application/json

###

POST {{MuseumStorage.Api_HostAddress}}/api/sensor-readings
Content-Type: application/json

{
  "deviceId": "museum-storage-01",
  "temperature": 22.5,
  "humidity": 53.0,
  "lightLevel": 500,
  "fanEnabled": false,
  "alarmEnabled": false
}

###

# Assign museum-storage-01 to a zone in the registry before requesting its settings by device.
GET {{MuseumStorage.Api_HostAddress}}/api/environment-settings?deviceId=museum-storage-01
Accept: application/json

###

# Use an existing zone ID from GET /api/storage-zones.
GET {{MuseumStorage.Api_HostAddress}}/api/storage-zones/{{ZoneId}}/environment-settings
Accept: application/json

###

PUT {{MuseumStorage.Api_HostAddress}}/api/storage-zones/{{ZoneId}}/environment-settings
Content-Type: application/json

{
  "fanOnTemperature": 26.0,
  "fanOffTemperature": 25.0,
  "fanOnHumidity": 70.0,
  "fanOffHumidity": 65.0,
  "temperatureAlarm": 30.0,
  "humidityAlarm": 80.0
}

###

# Run the storage workflow requests in order. Use fresh codes for another run.
# @name createDemoZone
POST {{MuseumStorage.Api_HostAddress}}/api/storage-zones
Content-Type: application/json

{
  "code": "ZONE-DEMO",
  "name": "Demo storage zone"
}

###

# @name createCheckInLocation
POST {{MuseumStorage.Api_HostAddress}}/api/storage-locations
Content-Type: application/json

{
  "code": "SHELF-DEMO-A1",
  "name": "Demo Shelf A1",
  "storageZoneId": {{createDemoZone.response.body.$.id}}
}

###

# @name createMoveLocation
POST {{MuseumStorage.Api_HostAddress}}/api/storage-locations
Content-Type: application/json

{
  "code": "SHELF-DEMO-B2",
  "name": "Demo Shelf B2",
  "storageZoneId": {{createDemoZone.response.body.$.id}}
}

###

# @name createExhibit
POST {{MuseumStorage.Api_HostAddress}}/api/exhibits
Content-Type: application/json

{
  "code": "EXHIBIT-DEMO-0001",
  "name": "Ceramic Bowl",
  "status": "CheckedOut"
}

###

POST {{MuseumStorage.Api_HostAddress}}/api/exhibits/{{createExhibit.response.body.$.id}}/check-in
Content-Type: application/json

{
  "storageLocationId": {{createCheckInLocation.response.body.$.id}}
}

###

POST {{MuseumStorage.Api_HostAddress}}/api/exhibits/{{createExhibit.response.body.$.id}}/move
Content-Type: application/json

{
  "storageLocationId": {{createMoveLocation.response.body.$.id}}
}

###

POST {{MuseumStorage.Api_HostAddress}}/api/exhibits/{{createExhibit.response.body.$.id}}/check-out

###

GET {{MuseumStorage.Api_HostAddress}}/api/exhibits/{{createExhibit.response.body.$.id}}/operations
Accept: application/json

###

# Upload a PNG or JPEG with a QR code for an existing exhibit.
# curl.exe -F "file=@exhibit-qr.png" http://localhost:5054/api/exhibits/scan-qr
